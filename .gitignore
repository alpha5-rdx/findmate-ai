# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Secrets & local configuration (NEVER commit) ----
.env
.env.*
!.env.example
*.env
.streamlit/secrets.toml
**/secrets.toml
!.streamlit/secrets.toml.example
*.pem
*.key

# ---- Application data (contains personal information) ----
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3
uploads/*
!uploads/.gitkeep

# ---- Test / tooling caches ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Logs & OS / editor files ----
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
